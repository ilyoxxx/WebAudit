{
  "name": "webaudit",
  "version": "0.1.0",
  "description": "Scanner d'audit web sécurité + RGPD, à règles modulaires",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/server/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server/server.js",
    "test": "vitest run",
    "new:rule": "node scripts/new-rule.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "cheerio": "^1.0.0",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
